@pytest.fixture(scope="session")
def {{ package }}_api_client(set_config) -> {{ package }}.ApiClient:
    host = v.get('service.{{ package }}')
    host_part = re.sub(r"^\w+://", "", host.rstrip("/"))
    output_dir = f"swagger-coverage-output/{host_part}-{{ package }}"
    trace = _coverage_trace(host, output_dir, '{{ package }}')

    configuration = {{ package }}.Configuration(host=host)
    api_client = {{ package }}.ApiClient(
        configuration=configuration,
        header_name="Authorization",
        header_value="api_key"
    )

    rest_client = api_client.rest_client
    original_request = rest_client.request.__func__

    async def patched_request(self, *args, **kwargs):
        if self.pool_manager is None or self.pool_manager.closed:
            self.pool_manager = aiohttp.ClientSession(
                trust_env=True,
                trace_configs=[trace],
            )
        return await original_request(self, *args, **kwargs)

    rest_client.request = types.MethodType(patched_request, rest_client)
    return api_client

